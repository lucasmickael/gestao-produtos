<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Produtos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark mb-5">
    <div class="container">
      <a class="navbar-brand" href="/"><i class="bi bi-box-seam me-2"></i>Gestão Pro</a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link active" href="/produtos">Produtos</a>
        <a class="nav-link" href="/categorias">Categorias</a>
      </div>
    </div>
  </nav>

  <div class="container">
    
    <div class="page-header">
      <h2 class="mb-0"><i class="bi bi-box me-2 text-primary"></i>Produtos</h2>
      <a href="/produtos/novo" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Novo Produto</a>
    </div>

    <!-- Filtros e Busca -->
    <div class="card mb-4 border-0">
      <div class="card-body p-4 bg-white rounded-3 shadow-sm" style="transform: none;">
        <div class="row align-items-end g-3">
          
          <div class="col-md-5">
            <form action="/produtos" method="GET">
              <label class="form-label text-muted small fw-bold text-uppercase">Pesquisar</label>
              <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="busca" class="form-control border-start-0 ps-0" placeholder="Buscar por nome..." value="<%= busca || '' %>">
                <button type="submit" class="btn btn-primary px-4">Buscar</button>
              </div>
            </form>
          </div>
          
          <div class="col-md-7 text-md-end">
            <div class="d-flex flex-wrap justify-content-md-end align-items-center gap-2">
              <span class="text-muted small fw-bold text-uppercase me-2 d-none d-md-inline">Categorias:</span>
              <a href="/produtos" class="btn btn-sm <%= !locals.categoriaFiltro ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3">Todas</a>
              <% categorias.forEach(c => { %>
                <!-- Assumindo que podemos checar a URL para o active, ou simplificando pro EJS -->
                <a href="/produtos/categoria/<%= c.id %>" class="btn btn-sm btn-outline-secondary rounded-pill px-3"><%= c.nome %></a>
              <% }) %>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Tabela -->
    <div class="card">
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead>
            <tr>
              <th class="ps-4">Produto</th>
              <th>Categoria</th>
              <th>Preço</th>
              <th>Estoque</th>
              <th class="text-end pe-4">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (produtos.length === 0) { %>
              <tr>
                <td colspan="5" class="text-center py-5 text-muted">
                  <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                  Nenhum produto encontrado.
                </td>
              </tr>
            <% } %>
            <% produtos.forEach(p => { %>
              <tr>
                <td class="ps-4 fw-bold text-dark"><%= p.nome %></td>
                <td>
                  <span class="badge bg-secondary text-dark px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-tag-fill me-1 text-muted"></i><%= p.categoria ? p.categoria.nome : 'Sem Categoria' %>
                  </span>
                </td>
                <td class="fw-medium text-success">R$ <%= p.preco.toFixed(2).replace('.', ',') %></td>
                <td>
                  <% if(p.quantidade < 5) { %>
                    <span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i><%= p.quantidade %> unid.</span>
                  <% } else { %>
                    <span class="text-muted"><%= p.quantidade %> unid.</span>
                  <% } %>
                </td>
                <td class="text-end pe-4">
                  <div class="d-inline-flex gap-2">
                    <a href="/produtos/<%= p.id %>/editar" class="btn btn-sm btn-light text-primary border" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                    <form action="/produtos/<%= p.id %>/deletar" method="POST" class="m-0" onsubmit="return confirm('Tem certeza que deseja excluir este produto?');">
                      <button type="submit" class="btn btn-sm btn-light text-danger border" title="Excluir"><i class="bi bi-trash3-fill"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>

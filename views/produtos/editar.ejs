<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Editar Produto</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark mb-5">
    <div class="container">
      <a class="navbar-brand" href="/"><i class="bi bi-box-seam me-2"></i>Gestão Pro</a>
    </div>
  </nav>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        
        <div class="d-flex align-items-center mb-4">
          <a href="/produtos" class="btn btn-sm btn-light text-muted me-3 border"><i class="bi bi-arrow-left"></i> Voltar</a>
          <h3 class="mb-0">Editar Produto</h3>
        </div>

        <div class="card p-2 border-0">
          <div class="card-body">
            <form action="/produtos/<%= produto.id %>" method="POST">
              
              <div class="mb-4">
                <label class="form-label text-muted fw-bold small text-uppercase">Nome do Produto</label>
                <div class="input-group">
                  <span class="input-group-text bg-light"><i class="bi bi-box"></i></span>
                  <input type="text" name="nome" class="form-control" value="<%= produto.nome %>" required>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-4">
                  <label class="form-label text-muted fw-bold small text-uppercase">Preço (R$)</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light text-success fw-bold">R$</span>
                    <input type="number" name="preco" class="form-control" step="0.01" value="<%= produto.preco %>" required>
                  </div>
                </div>
                <div class="col-md-6 mb-4">
                  <label class="form-label text-muted fw-bold small text-uppercase">Estoque</label>
                  <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-boxes"></i></span>
                    <input type="number" name="quantidade" class="form-control" value="<%= produto.quantidade %>" required>
                  </div>
                </div>
              </div>

              <div class="mb-4">
                <label class="form-label text-muted fw-bold small text-uppercase">Categoria</label>
                <div class="input-group">
                  <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                  <select name="categoriaId" class="form-select" required>
                    <% categorias.forEach(c => { %>
                      <option value="<%= c.id %>" <%= produto.categoriaId == c.id ? 'selected' : '' %>><%= c.nome %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="d-grid gap-2 mt-5">
                <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm"><i class="bi bi-check-circle me-2"></i>Salvar Alterações</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Categorias</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark mb-5">
    <div class="container">
      <a class="navbar-brand" href="/"><i class="bi bi-box-seam me-2"></i>Gestão Pro</a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/produtos">Produtos</a>
        <a class="nav-link active" href="/categorias">Categorias</a>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h2 class="mb-0"><i class="bi bi-tags me-2 text-primary"></i>Categorias</h2>
      <a href="/categorias/novo" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Nova Categoria</a>
    </div>
    
    <div class="card">
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead>
            <tr>
              <th class="ps-4" style="width: 100px;">ID</th>
              <th>Nome da Categoria</th>
            </tr>
          </thead>
          <tbody>
            <% if (categorias.length === 0) { %>
              <tr><td colspan="2" class="text-center py-5 text-muted">Nenhuma categoria cadastrada. Comece adicionando uma!</td></tr>
            <% } %>
            <% categorias.forEach(c => { %>
              <tr>
                <td class="ps-4 fw-bold text-muted">#<%= c.id %></td>
                <td class="fw-medium"><%= c.nome %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
